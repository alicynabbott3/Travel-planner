# ─── Firebase Realtime Database ───────────────────────────────────────────────
# Copy this file to .env and fill in your values from the Firebase console.
# Firebase console: https://console.firebase.google.com
#   Project Settings → Your apps → Web app → SDK setup → Config object

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_DATABASE_URL=          # e.g. https://your-project-default-rtdb.firebaseio.com
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
